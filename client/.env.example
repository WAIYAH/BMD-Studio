# ---------------------------------------------------------------------------
# B.M.D Studio — web client environment
# Copy to `client/.env`. Anything prefixed VITE_ is embedded in the JS bundle
# and is therefore PUBLIC. Never put a secret in this file.
# ---------------------------------------------------------------------------

# Base URL for API calls. Left as a relative path in development so requests go
# through the Vite proxy and stay same-origin.
VITE_API_URL=/api/v1

# Dev-server proxy target for /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000

# Public site origin, used for share links and Open Graph URLs.
VITE_SITE_URL=http://localhost:5173
