/// Photography is modelled as services under a photography category; a package
/// adds the deliverable terms that a plain service has no room for.
model PhotographyPackage {
  id                String   @id @default(cuid())
  serviceId         String   @map("service_id")
  name              String
  description       String?
  deliverableCount  Int      @map("deliverable_count")
  editTurnaroundDays Int     @map("edit_turnaround_days")
  priceCents        Int      @map("price_cents")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  service  Service   @relation(fields: [serviceId], references: [id], onDelete: Cascade)
  bookings Booking[]

  @@index([serviceId, isActive])
  @@map("photography_packages")
}

model BookingDeliverable {
  id          String    @id @default(cuid())
  bookingId   String    @map("booking_id")
  galleryId   String?   @map("gallery_id")
  title       String
  notes       String?
  dueAt       DateTime? @map("due_at") @db.Timestamptz(3)
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz(3)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  booking Booking  @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  gallery Gallery? @relation(fields: [galleryId], references: [id], onDelete: SetNull)

  @@index([bookingId])
  @@map("booking_deliverables")
}

// ---------------------------------------------------------------------------
// PAYMENTS
// ---------------------------------------------------------------------------

/// A payment is an independent record, not a field on a booking. Its status is
/// only ever moved by a backend-verified provider callback (R4) — never by
/// anything a client asserts.
model Payment {
  id         String          @id @default(cuid())
  reference  String          @unique
  customerId String          @map("customer_id")
  bookingId  String?         @map("booking_id")
  rentalId   String?         @map("rental_id")
  provider   PaymentProvider
  purpose    PaymentPurpose  @default(BOOKING)
  status     PaymentStatus   @default(PENDING)

  amountCents Int    @map("amount_cents")
  currency    String @default("KES")

  /// Supplied by the client on initiation; a repeat with the same key returns
  /// the original payment instead of starting a second one.
  idempotencyKey String  @unique @map("idempotency_key")
  /// Payer identity as given to the provider (M-Pesa MSISDN, card fingerprint).
  payerRef       String? @map("payer_ref")
  /// Provider-side identifier once known (CheckoutRequestID, PaymentIntent id).
  providerRef    String? @map("provider_ref")
  /// M-Pesa receipt number or equivalent, present only on success.
  receiptNumber  String? @unique @map("receipt_number")

  failureReason String?   @map("failure_reason")
  paidAt        DateTime? @map("paid_at") @db.Timestamptz(3)
  /// Initiation deadline; a PENDING payment past this is swept to CANCELLED.
  expiresAt     DateTime? @map("expires_at") @db.Timestamptz(3)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt     DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer User             @relation(fields: [customerId], references: [id], onDelete: Restrict)
  booking  Booking?         @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rental   EquipmentRental? @relation(fields: [rentalId], references: [id], onDelete: SetNull)

  transactions PaymentTransaction[]
  refunds      Refund[]

  @@index([status, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([bookingId])
  @@index([rentalId])
  @@map("payments")
}

/// Append-only provider event ledger. Rows are never updated or deleted: this
/// is the audit trail that explains why a payment holds the status it holds.
model PaymentTransaction {
  id          String                 @id @default(cuid())
  paymentId   String                 @map("payment_id")
  kind        PaymentTransactionKind
  provider    PaymentProvider
  /// Provider transaction id. Unique per provider, which is what makes a
  /// replayed callback a no-op rather than a double credit (R4).
  providerRef String                 @map("provider_ref")
  resultCode  String?                @map("result_code")
  resultDesc  String?                @map("result_desc")
  amountCents Int?                   @map("amount_cents")
  /// Verbatim provider payload, redacted of secrets before it is logged.
  rawPayload  Json                   @map("raw_payload")
  /// False when a callback arrived but its signature or source could not be
  /// verified. Such a row is recorded and then ignored.
  signatureVerified Boolean          @default(false) @map("signature_verified")
  sourceIp    String?                @map("source_ip")
  receivedAt  DateTime               @default(now()) @map("received_at") @db.Timestamptz(3)
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)

  @@unique([provider, providerRef])
  @@index([paymentId, receivedAt])
  @@map("payment_transactions")
}

model Refund {
  id          String       @id @default(cuid())
  paymentId   String       @map("payment_id")
  amountCents Int          @map("amount_cents")
  reason      String
  status      RefundStatus @default(PENDING)
  providerRef String?      @map("provider_ref")
  requestedById String?    @map("requested_by_id")
  processedAt DateTime?    @map("processed_at") @db.Timestamptz(3)
  failureReason String?    @map("failure_reason")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz(3)

  payment Payment @relation(fields: [paymentId], references: [id], onDelete: Restrict)

  @@index([paymentId])
  @@index([status, createdAt(sort: Desc)])
  @@map("refunds")
}

// ---------------------------------------------------------------------------
// NOTIFICATIONS
// ---------------------------------------------------------------------------

model Notification {
  id        String    @id @default(cuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String
  data      Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([userId, createdAt(sort: Desc)])
  @@map("notifications")
}

model NotificationPreference {
  userId    String              @map("user_id")
  channel   NotificationChannel
  /// Notification family, e.g. `booking`, `payment`, `reminder`.
  category  String
  enabled   Boolean             @default(true)
  createdAt DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, channel, category])
  @@map("notification_preferences")
}

/// Transactional outbox. Dispatch is a separate job reading this table, so a
/// delivery failure is retryable and auditable instead of lost in a request.
model NotificationOutbox {
  id         String              @id @default(cuid())
  channel    NotificationChannel
  /// Email address, E.164 phone, or device token depending on `channel`.
  recipient  String
  template   String
  payload    Json
  status     OutboxStatus        @default(QUEUED)
  attempts   Int                 @default(0)
  maxAttempts Int                @default(5) @map("max_attempts")
  lastError  String?             @map("last_error")
  /// Earliest time the dispatcher may attempt this row; backoff moves it out.
  sendAfter  DateTime            @default(now()) @map("send_after") @db.Timestamptz(3)
  sentAt     DateTime?           @map("sent_at") @db.Timestamptz(3)
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@index([status, sendAfter])
  @@map("notification_outbox")
}

// ---------------------------------------------------------------------------
// ADMINISTRATION
// ---------------------------------------------------------------------------

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?  @map("actor_id")
  actorIp    String?  @map("actor_ip")
  actorAgent String?  @map("actor_agent")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  /// Correlates an audit row with the request that produced it.
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt(sort: Desc)])
  @@index([actorId, createdAt(sort: Desc)])
  @@index([createdAt(sort: Desc)])
  @@map("audit_logs")
}

model Setting {
  key         String   @id
  value       Json
  description String?
  updatedById String?  @map("updated_by_id")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  updatedBy User? @relation(fields: [updatedById], references: [id], onDelete: SetNull)

  @@map("settings")
}

/// Scheduler bookkeeping: which recurring job ran, when, and how it ended.
model Job {
  name        String    @id
  status      JobStatus @default(IDLE)
  lastRunAt   DateTime? @map("last_run_at") @db.Timestamptz(3)
  lastEndedAt DateTime? @map("last_ended_at") @db.Timestamptz(3)
  lastError   String?   @map("last_error")
  runCount    Int       @default(0) @map("run_count")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("jobs")
}
