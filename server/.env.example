# ---------------------------------------------------------------------------
# B.M.D Studio — server environment
# Copy to `server/.env` and fill in. NEVER commit a filled-in copy.
# Every variable the application reads is documented here.
# ---------------------------------------------------------------------------

# --- core ------------------------------------------------------------------
NODE_ENV=development
PORT=4000
# Comma-separated list of origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173
# Public base URL of this API (used for callbacks and links in emails).
API_PUBLIC_URL=http://localhost:4000
# Public base URL of the web client (used for links in emails/SMS).
CLIENT_PUBLIC_URL=http://localhost:5173
LOG_LEVEL=debug
TIMEZONE=Africa/Nairobi

# --- database (Phase 2) ----------------------------------------------------
DATABASE_URL=postgresql://bmd:bmd_dev_password@localhost:5432/bmd_studio?schema=public
# Used only by the integration test suite; must be a throwaway database.
TEST_DATABASE_URL=postgresql://bmd:bmd_dev_password@localhost:5433/bmd_studio_test?schema=public

# --- authentication (Phase 3) ----------------------------------------------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=replace-me-with-a-long-random-value
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
# Cookie settings for the refresh token.
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# --- object storage / media (Phase 9) --------------------------------------
# S3-compatible. Local development uses the MinIO service in docker-compose.
STORAGE_DRIVER=s3
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=bmd-studio-media
S3_ACCESS_KEY_ID=bmd_minio
S3_SECRET_ACCESS_KEY=bmd_minio_dev_password
S3_FORCE_PATH_STYLE=true
# Public CDN/base URL for publicly readable media, if one is configured.
MEDIA_PUBLIC_BASE_URL=http://localhost:9000/bmd-studio-media
MAX_UPLOAD_MB=50

# --- payments: M-Pesa Daraja (Phase 10) ------------------------------------
# `daraja` for the real Safaricom API, `mock` for local development only.
# `mock` is rejected when NODE_ENV=production.
PAYMENTS_DRIVER=mock
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
# Must be a publicly reachable HTTPS URL; use a tunnel in development.
MPESA_CALLBACK_URL=https://example.ngrok.app/api/v1/payments/mpesa/callback
# Comma-separated Safaricom source IPs permitted to post callbacks.
MPESA_CALLBACK_IP_ALLOWLIST=

# --- payments: Stripe (Phase 10, optional card rail) ------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# --- streaming (Phase 8) ---------------------------------------------------
# Leave blank to run with streaming integrations reported as "not configured".
YOUTUBE_API_KEY=
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
YOUTUBE_REFRESH_TOKEN=
YOUTUBE_CHANNEL_ID=
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
STREAM_STATS_POLL_SECONDS=60

# --- notifications (Phase 11) ----------------------------------------------
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM="B.M.D Studio <no-reply@bmdstudio.co.ke>"

SMS_DRIVER=log
AFRICASTALKING_USERNAME=
AFRICASTALKING_API_KEY=
AFRICASTALKING_SENDER_ID=

WHATSAPP_DRIVER=log
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=

# --- rate limiting ---------------------------------------------------------
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
